# Copy this file to .env. All generated local secrets are placeholders and must
# be replaced by scripts/project.ps1 init; AWS values must be supplied by you.
SOURCE_DB_PASSWORD=
AIRFLOW_DB_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_EMAIL=admin@localhost
AIRFLOW_PORT=8080
SOURCE_POSTGRES_PORT=5433
SPARK_UI_PORT=4040
DASHBOARD_PORT=8501
INPUT_MODE=cdc

# AWS S3 configuration for the real file-ingestion route.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Required only when using temporary AWS credentials; otherwise leave unset.
AWS_SESSION_TOKEN=

# Existing bucket name, without s3:// or a path.
S3_BUCKET=
# Use a project-specific prefix, separate from Cortex objects.
S3_PREFIX=retail-lakehouse/dev/
